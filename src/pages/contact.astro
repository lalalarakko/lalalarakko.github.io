---
import BaseLayout from '../layouts/BaseLayout.astro';
import { load } from 'js-yaml';
import { readFileSync } from 'fs';
import { join } from 'path';

function parseFrontmatter(raw: string) {
  const match = raw.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return {};
  return load(match[1]) as Record<string, any>;
}

const contact = parseFrontmatter(readFileSync(join(process.cwd(), 'src/content/contact.md'), 'utf-8'));
const profiles = contact.profiles || [];
const addressEnLines = (contact.address_en || '').trim().split('\n');
const addressJpLines = (contact.address_jp || '').trim().split('\n');
---
<BaseLayout title="Contact — Masanori Takezawa" activePage="contact">
<style>
.page-top{margin-top:var(--nav-h);}
.contact-hero{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--black);min-height:340px;}
.contact-hero-left{padding:64px 48px;border-right:1px solid var(--black);}
.contact-hero-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:14px;}
.contact-hero-title{font-family:var(--serif);font-size:clamp(40px,5vw,68px);font-weight:400;line-height:1.05;letter-spacing:-.01em;margin-bottom:24px;}
.contact-hero-desc{font-size:15px;color:var(--gray-dark);font-weight:400;line-height:1.85;max-width:480px;}
.contact-hero-right{padding:64px 48px;display:flex;flex-direction:column;justify-content:center;gap:28px;}
.contact-block-label{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--gray-mid);margin-bottom:8px;}
.contact-email{font-family:var(--serif);font-size:22px;color:var(--black);font-style:italic;}
.contact-address{font-size:15px;color:var(--gray-dark);font-weight:400;line-height:1.9;}
.contact-address strong{font-weight:500;color:var(--black);}
.contact-address-jp{font-family:var(--jp);font-size:13px;color:var(--gray-dark);line-height:2.0;margin-top:12px;padding-top:12px;border-top:1px solid var(--gray-light);}
.profiles-section{padding:64px 48px;border-bottom:1px solid var(--black);}
.profiles-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:36px;}
.profiles-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--black);border:1px solid var(--black);}
.profile-card{background:var(--white);padding:36px 32px;transition:background .2s;display:flex;flex-direction:column;justify-content:space-between;min-height:160px;}
.profile-card:hover{background:#f0efe9;}
.profile-card-header{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:10px;}
.profile-service{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:500;}
.profile-card-title{font-size:17px;font-weight:500;margin-bottom:8px;}
.profile-card-desc{font-size:13px;color:var(--gray-dark);font-weight:400;line-height:1.65;flex-grow:1;margin-bottom:20px;}
.profile-card-link{font-size:12px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:var(--black);display:inline-flex;align-items:center;gap:8px;border-bottom:1px solid var(--black);padding-bottom:2px;width:fit-content;transition:all .2s;}
.profile-card-link:hover{color:var(--accent);border-color:var(--accent);}
.profile-card-link::after{content:'↗';}
@media(max-width:900px){
  .contact-hero{grid-template-columns:1fr;}
  .contact-hero-left{border-right:none;padding:48px 20px;}
  .contact-hero-right{padding:32px 20px;border-top:1px solid var(--black);}
  .profiles-section{padding:40px 20px;}
  .profiles-grid{grid-template-columns:1fr;}
}
</style>

<div class="page-top">
  <div class="contact-hero">
    <div class="contact-hero-left">
      <p class="contact-hero-label">Get in Touch</p>
      <h1 class="contact-hero-title">Contact</h1>
      <p class="contact-hero-desc">I welcome inquiries about research collaboration, graduate admission to the lab, and media or public engagement.</p>
    </div>
    <div class="contact-hero-right">
      <div>
        <p class="contact-block-label">Email</p>
        <p class="contact-email">{contact.email}</p>
      </div>
      <div>
        <p class="contact-block-label">Postal Address</p>
        <div class="contact-address">
          <strong>{addressEnLines[0]}</strong><br/>
          {addressEnLines.slice(1).map((line: string) => <>{line}<br/></>)}
        </div>
        <div class="contact-address-jp">
          {addressJpLines.map((line: string) => <>{line}<br/></>)}
        </div>
      </div>
    </div>
  </div>

  <div class="profiles-section">
    <p class="profiles-label">Academic Profiles</p>
    <div class="profiles-grid">
      {profiles.map((p: any) => (
        <div class="profile-card">
          <div>
            <div class="profile-card-header">
              <span class="profile-service">{p.service}</span>
            </div>
            <p class="profile-card-title">{p.service}</p>
            <p class="profile-card-desc">{p.description}</p>
          </div>
          <a class="profile-card-link" href={p.url} target="_blank">
            {p.id || 'View Profile'}
          </a>
        </div>
      ))}
    </div>
  </div>
</div>
</BaseLayout>
