---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Lab — Masanori Takezawa" activePage="lab">
<style>












.page-top{margin-top:var(--nav-h);}
.page-header{border-bottom:1px solid var(--black);padding:64px 48px 48px;}
.page-header-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:12px;}
.page-header-title{font-family:var(--serif);font-size:clamp(40px,5vw,72px);font-weight:400;line-height:1.05;letter-spacing:-.01em;margin-bottom:16px;}
.page-header-desc{font-size:15px;color:var(--gray-dark);font-weight:400;max-width:640px;line-height:1.8;}

/* SECTION TABS */
.section-tabs{display:flex;border-bottom:1px solid var(--black);position:sticky;top:var(--nav-h);background:var(--white);z-index:50;}
.section-tab{padding:20px 32px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;border:none;background:none;font-family:var(--sans);color:var(--gray-dark);border-bottom:3px solid transparent;margin-bottom:-1px;transition:all .2s;}
.section-tab.active{color:var(--black);border-bottom-color:var(--black);}
.section-tab:hover:not(.active){color:var(--black);}
.tab-panel{display:none;}.tab-panel.active{display:block;}

/* MEMBERS */
.members-section{padding:56px 48px;border-bottom:1px solid var(--black);}
.members-section:last-child{border-bottom:none;}
.members-section-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:24px;}
.members-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px;}
.member-card{background:var(--white);padding:28px 24px;border:1px solid var(--gray-light);transition:border-color .2s,box-shadow .2s;}
.member-card:hover{border-color:var(--gray-mid);box-shadow:0 2px 12px rgba(0,0,0,.05);}
.member-name{font-size:15px;font-weight:500;margin-bottom:3px;}
.member-name-jp{font-family:var(--jp);font-size:13px;font-weight:400;color:var(--gray-dark);margin-bottom:8px;letter-spacing:.06em;}
.member-degree{font-size:13px;letter-spacing:.07em;text-transform:uppercase;color:var(--accent);margin-bottom:6px;}
.member-topic{font-size:13px;color:var(--gray-dark);font-weight:400;line-height:1.6;}
/* Compact student list (B3/B4) */
.students-list-wrap{border:1px solid var(--black);}
.students-list-header{display:grid;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--gray-mid);padding:10px 20px;border-bottom:1px solid var(--black);background:var(--white);}
.students-row{display:flex;align-items:baseline;gap:16px;padding:10px 20px;border-bottom:1px solid var(--gray-light);font-size:14px;}
.students-row:last-child{border-bottom:none;}
.students-row-jp{font-family:var(--jp);font-weight:400;}
.students-row-year{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);white-space:nowrap;}

/* ALUMNI */
.alumni-section{padding:64px 48px;}
.alumni-section-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:28px;}
.alumni-table{width:100%;border-collapse:collapse;table-layout:fixed;}
.alumni-table th{text-align:left;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--gray-mid);font-weight:400;padding:0 0 14px;border-bottom:1px solid var(--black);}
.alumni-table td{padding:16px 12px 16px 0;border-bottom:1px solid var(--gray-light);vertical-align:top;}
.alumni-table tr:last-child td{border-bottom:none;}
.alumni-yr{width:64px;font-size:13px;color:var(--gray-mid);padding-top:18px;}
.alumni-name-en{font-size:15px;font-weight:500;margin-bottom:2px;}
.alumni-name-jp{font-family:var(--jp);font-size:12px;font-weight:400;color:var(--gray-mid);margin-bottom:3px;}
.alumni-inst{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--gray-mid);margin-bottom:6px;}
.alumni-thesis{font-size:12px;color:var(--gray-dark);font-style:italic;line-height:1.55;margin-top:4px;}
.alumni-thesis.tba{color:var(--gray-mid);font-style:normal;}
.alumni-links{display:flex;gap:12px;margin-top:8px;}
.alumni-links a{font-size:13px;letter-spacing:.04em;text-transform:uppercase;text-decoration:none;color:var(--accent);}
.alumni-links a:hover{text-decoration:underline;}
.alumni-pos-cell{font-size:14px;padding-top:18px;}
.alumni-pos-title{font-weight:500;margin-bottom:2px;}
.alumni-pos-org{font-size:12px;color:var(--gray-dark);font-weight:400;line-height:1.5;}

/* MA ALUMNI (compact) */
.ma-alumni-section{padding:0 48px 64px;}
.ma-alumni-section-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:20px;padding-top:48px;border-top:1px solid var(--black);}
.ma-table{width:100%;border-collapse:collapse;table-layout:fixed;}
.ma-table th{text-align:left;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--gray-mid);font-weight:400;padding:0 0 12px;border-bottom:1px solid var(--black);}
.ma-table td{padding:10px 12px 10px 0;border-bottom:1px solid var(--gray-light);font-size:14px;vertical-align:middle;}
.ma-table tr:last-child td{border-bottom:none;}
.ma-yr{width:64px;font-size:13px;color:var(--gray-mid);}
.ma-name-en{font-size:14px;font-weight:500;color:var(--black);}
.ma-name-jp{font-family:var(--jp);font-size:13px;font-weight:400;color:var(--gray-mid);}

/* THESES */
.thesis-section{padding:64px 48px;}
.thesis-section-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:8px;}
.thesis-tabs{display:flex;gap:0;margin-bottom:32px;border-bottom:1px solid var(--gray-light);}
.thesis-subtab{padding:12px 24px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;border:none;background:none;font-family:var(--sans);color:var(--gray-mid);border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .2s;}
.thesis-subtab.active{color:var(--black);border-bottom-color:var(--black);}
.thesis-subpanel{display:none;}.thesis-subpanel.active{display:block;}
.thesis-year-heading{font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--black);font-weight:500;padding:20px 0 12px;border-top:1px solid var(--black);margin-top:28px;}
.thesis-year-heading.first{margin-top:0;border-top:2px solid var(--black);}
.thesis-item{display:grid;grid-template-columns:44px 1fr;gap:10px 18px;padding:12px 0;border-bottom:1px solid var(--gray-light);align-items:start;}
.thesis-item:last-child{border-bottom:none;}
.thesis-deg{font-size:12px;letter-spacing:.06em;text-transform:uppercase;padding:3px 6px;border:1px solid;white-space:nowrap;margin-top:2px;}
.thesis-deg.phd{border-color:var(--black);color:var(--black);}
.thesis-deg.ma{border-color:var(--gray-mid);color:var(--gray-mid);}
.thesis-deg.ba{border-color:var(--gray-light);color:var(--gray-mid);}
.thesis-title{font-size:14px;line-height:1.55;margin-bottom:3px;}
.thesis-author{font-family:var(--jp);font-size:12px;color:var(--gray-mid);}
.thesis-pos{font-size:13px;color:var(--gray-mid);margin-top:2px;}

/* NEWS */
.news-section{padding:64px 48px;}
.news-note{font-size:13px;color:var(--gray-dark);font-weight:400;line-height:1.8;border-left:3px solid var(--gray-light);padding-left:20px;margin-bottom:36px;max-width:600px;}
.news-filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:32px;}
.news-filter-btn{padding:6px 16px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;font-family:var(--sans);background:none;border:1px solid var(--gray-light);cursor:pointer;transition:all .2s;color:var(--gray-dark);}
.news-filter-btn:hover{border-color:var(--gray-mid);color:var(--black);}
.news-filter-btn.active{background:var(--black);color:var(--white);border-color:var(--black);}
.news-list{list-style:none;}
.news-item{display:grid;grid-template-columns:80px 1fr;gap:16px;padding:18px 0;border-bottom:1px solid var(--gray-light);align-items:start;}
.news-item:last-child{border-bottom:none;}
.news-item.hidden{display:none;}
.news-date{font-size:12px;color:var(--gray-mid);padding-top:3px;white-space:nowrap;}
.news-body{font-family:var(--jp);font-size:14px;font-weight:400;line-height:1.8;}
.news-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px;}
.news-tag{font-size:12px;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border:1px solid;display:inline-block;}
.news-tag.award{border-color:var(--accent);color:var(--accent);}
.news-tag.jsps{border-color:#2980b9;color:#2980b9;}
.news-tag.grant{border-color:#27ae60;color:#27ae60;}
.news-
.news-body a{color:var(--accent);text-decoration:none;font-size:13px;letter-spacing:.04em;text-transform:uppercase;margin-left:8px;vertical-align:middle;}
.news-body a:hover{text-decoration:underline;}








@media(max-width:900px){
  
  .page-header{padding:48px 20px 32px;}
  .members-section,.alumni-section,.ma-alumni-section,.thesis-section,.news-section{padding-left:20px;padding-right:20px;}
  .section-tab{padding:16px 14px;font-size:13px;}
  .alumni-yr,.ma-yr{display:none;}
  /* PhD alumni: stack Current Position below Name on mobile */
  .alumni-table thead{display:none;}
  .alumni-table tr{display:block;padding:16px 0;border-bottom:1px solid var(--gray-light);}
  .alumni-table tr:last-child{border-bottom:none;}
  .alumni-table td{display:block;padding:0;border:none;}
  .alumni-pos-cell{margin-top:8px;padding-top:8px !important;border-top:1px solid var(--gray-light) !important;}
  /* Master's alumni: hide Japanese name column on very small screens */
  .ma-name-jp{font-size:12px;}
  .thesis-item{grid-template-columns:1fr;}.thesis-deg{display:inline-block;margin-bottom:4px;}
  
  
  /* Accessibility: larger fonts on mobile */
  
  
  .update-date,.update-text,.cv-entry-title,.cv-entry-place,.cv-entry-note{font-size:15px;}
  .pub-title{font-size:16px;} .pub-authors,.pub-journal{font-size:14px;}
  .section-num,.page-header-label,.perspective-label,.themes-num{font-size:13px;}
  .filter-btn,.pub-badge,.update-tag{font-size:12px;}
  .hero-affil{font-size:15px;} .hero-research-desc{font-size:15px;}
  .research-card-desc{font-size:14px;}
  .footer-links a,

}

/* ── MOBILE NAV ── */
.nav-hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;background:none;border:none;}
.nav-hamburger span{display:block;width:22px;height:1px;background:var(--black);transition:all .3s;}
.nav-hamburger.open span:nth-child(1){transform:translateY(6px) rotate(45deg);}
.nav-hamburger.open span:nth-child(2){opacity:0;}
.nav-hamburger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg);}
@media(max-width:680px){
  .nav-hamburger{display:flex;}
  
  .nav-links.open{display:flex;}
  .nav-links li{border-bottom:1px solid var(--gray-light);}
  
  
}

