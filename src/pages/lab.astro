---
import BaseLayout from '../layouts/BaseLayout.astro';
import { load } from 'js-yaml';
import { readFileSync } from 'fs';
import { join } from 'path';

function parseFrontmatter(raw: string) {
  const match = raw.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return {};
  return load(match[1]) as Record<string, any>;
}

const cwd = process.cwd();
const membersData = parseFrontmatter(readFileSync(join(cwd, 'src/content/lab/members.md'), 'utf-8'));
const alumniData  = parseFrontmatter(readFileSync(join(cwd, 'src/content/lab/alumni.md'), 'utf-8'));
const thesesData  = parseFrontmatter(readFileSync(join(cwd, 'src/content/lab/theses.md'), 'utf-8'));
const newsData    = parseFrontmatter(readFileSync(join(cwd, 'src/content/lab/news.md'), 'utf-8'));

const doctoral     = membersData.doctoral     || [];
const masters      = membersData.masters      || [];
const undergradB4  = membersData.undergrad_b4 || [];
const undergradB3  = membersData.undergrad_b3 || [];

const phdAlumni    = (alumniData.phd     || []).sort((a: any, b: any) => b.year - a.year);
const maAlumni     = (alumniData.masters || []).sort((a: any, b: any) => b.year - a.year);

const dissertations  = thesesData.dissertations   || [];
const mastersTheses  = thesesData.masters_theses  || [];
const baTheses       = thesesData.ba_theses       || [];

// Group theses by year
function groupByYear(items: any[]) {
  const d: Record<number, any[]> = {};
  for (const item of items) {
    if (!d[item.year]) d[item.year] = [];
    d[item.year].push(item);
  }
  return Object.keys(d).map(Number).sort((a,b) => b-a).map(y => ({ year: y, items: d[y] }));
}

const newsItems = newsData.news || [];
---
<BaseLayout title="Lab — Masanori Takezawa" activePage="lab">
<style>
.page-top{margin-top:var(--nav-h);}
.page-header{border-bottom:1px solid var(--black);padding:40px 48px 36px;}
.page-header-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:12px;}
.page-header-title{font-family:var(--serif);font-size:clamp(40px,5vw,72px);font-weight:400;line-height:1.05;letter-spacing:-.01em;margin-bottom:16px;}
.page-header-desc{font-size:15px;color:var(--gray-dark);font-weight:400;max-width:640px;line-height:1.8;}
.section-tabs{display:flex;border-bottom:1px solid var(--black);position:sticky;top:var(--nav-h);background:var(--white);z-index:50;}
.section-tab{padding:20px 32px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;border:none;background:none;font-family:var(--sans);color:var(--gray-dark);border-bottom:3px solid transparent;margin-bottom:-1px;transition:all .2s;}
.section-tab.active{color:var(--black);border-bottom-color:var(--black);}
.section-tab:hover:not(.active){color:var(--black);}
.tab-panel{display:none;}.tab-panel.active{display:block;}

/* Members */
.members-section{padding:56px 48px;border-bottom:1px solid var(--black);}
.members-section:last-child{border-bottom:none;}
.members-section-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:24px;}
.members-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px;}
.member-card{background:var(--white);padding:28px 24px;border:1px solid var(--gray-light);transition:border-color .2s;}
.member-card:hover{border-color:var(--gray-mid);}
.member-name{font-size:15px;font-weight:500;margin-bottom:3px;}
.member-name-jp{font-family:var(--jp);font-size:13px;font-weight:400;color:var(--gray-dark);margin-bottom:8px;letter-spacing:.06em;}
.member-degree{font-size:13px;letter-spacing:.07em;text-transform:uppercase;color:var(--accent);margin-bottom:6px;}
.alumni-links{display:flex;gap:12px;margin-top:8px;}
.alumni-links a{font-size:13px;letter-spacing:.04em;text-transform:uppercase;text-decoration:none;color:var(--accent);}
.alumni-links a:hover{text-decoration:underline;}
.students-list-wrap{border:1px solid var(--black);}
.students-row{display:flex;align-items:baseline;gap:16px;padding:10px 20px;border-bottom:1px solid var(--gray-light);font-size:14px;}
.students-row:last-child{border-bottom:none;}
.students-row-jp{font-family:var(--jp);font-weight:400;}
.students-row-year{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);white-space:nowrap;margin-left:auto;}
.students-header{display:flex;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--gray-dark);padding:10px 20px;border-bottom:1px solid var(--black);background:var(--gray-light);}

/* Alumni */
.alumni-section{padding:64px 48px;}
.alumni-section-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:28px;}
.alumni-table{width:100%;border-collapse:collapse;table-layout:fixed;}
.alumni-table th{text-align:left;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--gray-mid);font-weight:400;padding:0 0 14px;border-bottom:1px solid var(--black);}
.alumni-table td{padding:16px 12px 16px 0;border-bottom:1px solid var(--gray-light);vertical-align:top;}
.alumni-table tr:last-child td{border-bottom:none;}
.alumni-yr{width:64px;font-size:13px;color:var(--gray-mid);padding-top:18px;}
.alumni-name-en{font-size:15px;font-weight:500;margin-bottom:2px;}
.alumni-name-jp{font-family:var(--jp);font-size:12px;color:var(--gray-mid);margin-bottom:3px;}
.alumni-inst{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--gray-mid);margin-bottom:6px;}
.alumni-pos-cell{font-size:14px;padding-top:18px;}
.alumni-pos-title{font-weight:500;margin-bottom:2px;}
.alumni-pos-org{font-size:12px;color:var(--gray-dark);line-height:1.5;}
.ma-alumni-section{padding:0 48px 64px;}
.ma-alumni-section-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:20px;padding-top:48px;border-top:1px solid var(--black);}
.ma-table{width:100%;border-collapse:collapse;table-layout:fixed;}
.ma-table th{text-align:left;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--gray-mid);font-weight:400;padding:0 0 12px;border-bottom:1px solid var(--black);}
.ma-table td{padding:10px 12px 10px 0;border-bottom:1px solid var(--gray-light);font-size:14px;vertical-align:middle;}
.ma-table tr:last-child td{border-bottom:none;}
.ma-yr{width:64px;font-size:13px;color:var(--gray-mid);}
.ma-name-en{font-size:14px;font-weight:500;}
.ma-name-jp{font-family:var(--jp);font-size:13px;color:var(--gray-mid);}

/* Theses */
.thesis-section{padding:64px 48px;}
.thesis-section-label{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:8px;}
.thesis-tabs{display:flex;gap:0;margin-bottom:32px;border-bottom:1px solid var(--gray-light);}
.thesis-subtab{padding:12px 24px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;border:none;background:none;font-family:var(--sans);color:var(--gray-mid);border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .2s;}
.thesis-subtab.active{color:var(--black);border-bottom-color:var(--black);}
.thesis-subpanel{display:none;}.thesis-subpanel.active{display:block;}
.thesis-year-heading{font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--black);font-weight:500;padding:20px 0 12px;border-top:1px solid var(--black);margin-top:28px;}
.thesis-year-heading.first{margin-top:0;border-top:2px solid var(--black);}
.thesis-item{display:grid;grid-template-columns:44px 1fr;gap:10px 18px;padding:12px 0;border-bottom:1px solid var(--gray-light);align-items:start;}
.thesis-item:last-child{border-bottom:none;}
.thesis-deg{font-size:12px;letter-spacing:.06em;text-transform:uppercase;padding:3px 6px;border:1px solid;white-space:nowrap;margin-top:2px;}
.thesis-deg.phd{border-color:var(--black);color:var(--black);}
.thesis-deg.ma{border-color:var(--gray-mid);color:var(--gray-mid);}
.thesis-deg.ba{border-color:var(--gray-light);color:var(--gray-mid);}
.thesis-title{font-family:var(--jp);font-size:14px;line-height:1.55;margin-bottom:3px;}
.thesis-author{font-family:var(--jp);font-size:12px;color:var(--gray-mid);}
.thesis-note{font-size:12px;color:var(--gray-mid);margin-top:2px;}

/* News */
.news-section{padding:64px 48px;}
.news-note{font-size:13px;color:var(--gray-dark);line-height:1.8;border-left:3px solid var(--gray-light);padding-left:20px;margin-bottom:36px;max-width:600px;}
.news-filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:32px;}
.news-filter-btn{padding:6px 16px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;font-family:var(--sans);background:none;border:1px solid var(--gray-light);cursor:pointer;transition:all .2s;color:var(--gray-dark);}
.news-filter-btn:hover{border-color:var(--gray-mid);color:var(--black);}
.news-filter-btn.active{background:var(--black);color:var(--white);border-color:var(--black);}
.news-list{list-style:none;}
.news-item{display:grid;grid-template-columns:80px 1fr;gap:16px;padding:18px 0;border-bottom:1px solid var(--gray-light);align-items:start;}
.news-item:last-child{border-bottom:none;}
.news-item.hidden{display:none;}
.news-date{font-size:12px;color:var(--gray-mid);padding-top:3px;white-space:nowrap;}
.news-tags{display:flex;gap:6px;margin-bottom:6px;}
.news-tag{font-size:12px;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border:1px solid;display:inline-block;}
.news-tag.award{border-color:var(--accent);color:var(--accent);}
.news-tag.jsps{border-color:#2980b9;color:#2980b9;}
.news-tag.grant{border-color:#27ae60;color:#27ae60;}
.news-body{font-family:var(--jp);font-size:14px;font-weight:400;line-height:1.8;}
.news-body a{color:var(--accent);text-decoration:none;font-size:13px;letter-spacing:.04em;text-transform:uppercase;margin-left:8px;}
.news-body a:hover{text-decoration:underline;}

@media(max-width:900px){
  .page-header{padding:48px 20px 32px;}
  .members-section,.alumni-section,.ma-alumni-section,.thesis-section,.news-section{padding-left:20px;padding-right:20px;}
  .section-tab{padding:16px 14px;font-size:13px;}
  .alumni-table thead{display:none;}
  .alumni-table tr{display:block;padding:16px 0;border-bottom:1px solid var(--gray-light);}
  .alumni-table td{display:block;padding:0;border:none;}
  .alumni-pos-cell{margin-top:8px;padding-top:8px !important;border-top:1px solid var(--gray-light) !important;}
  .thesis-item{grid-template-columns:1fr;}
  .thesis-deg{display:inline-block;margin-bottom:4px;}
  .news-item{grid-template-columns:1fr;gap:4px;}
}
@media(max-width:680px){
  .section-tabs{overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
  .section-tabs::-webkit-scrollbar{display:none;}
}
</style>

<div class="page-top">
  <div class="page-header">
    <p class="page-header-label">Takezawa Laboratory</p>
    <h1 class="page-header-title">Lab</h1>
    <p class="page-header-desc">Hokkaido University · Department of Behavioral Science. We study the evolutionary and cognitive foundations of human sociality through experiments, computational models, and theoretical analysis.</p>
  </div>
  <div class="section-tabs">
    <button class="section-tab active" onclick="switchTab('members',this)">Current Members</button>
    <button class="section-tab" onclick="switchTab('alumni',this)">Alumni</button>
    <button class="section-tab" onclick="switchTab('theses',this)">Theses</button>
    <button class="section-tab" onclick="switchTab('news',this)">Lab News</button>
  </div>
</div>

<!-- MEMBERS -->
<div id="tab-members" class="tab-panel active">

  <div class="members-section">
    <p class="members-section-label">Doctoral Students</p>
    <div class="members-grid">
      {doctoral.map((m: any) => (
        <div class="member-card">
          <p class="member-name">{m.name_en}</p>
          <p class="member-name-jp">{m.name_jp}</p>
          <p class="member-degree">PhD Student · {m.year}</p>
          {(m.researchmap || m.website) && (
            <div class="alumni-links">
              {m.researchmap && <a href={m.researchmap} target="_blank">ResearchMap</a>}
              {m.website && <a href={m.website} target="_blank">Website</a>}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="members-section">
    <p class="members-section-label">Master's Students</p>
    <div class="members-grid">
      {masters.map((m: any) => (
        <div class="member-card">
          <p class="member-name">{m.name_en}</p>
          <p class="member-name-jp">{m.name_jp}</p>
          <p class="member-degree">M.A. Student · {m.year}</p>
          {(m.researchmap || m.website) && (
            <div class="alumni-links">
              {m.researchmap && <a href={m.researchmap} target="_blank">ResearchMap</a>}
              {m.website && <a href={m.website} target="_blank">Website</a>}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="members-section">
    <p class="members-section-label">Undergraduate Students</p>
    <div class="students-list-wrap">
      <div class="students-header">
        <span style="flex:1;">Name</span><span>Year</span>
      </div>
      {undergradB4.map((m: any) => (
        <div class="students-row">
          <span class="students-row-jp" style="flex:1;">{m.name_jp}</span>
          <span class="students-row-year">B4</span>
        </div>
      ))}
      {undergradB3.map((m: any) => (
        <div class="students-row">
          <span class="students-row-jp" style="flex:1;">{m.name_jp}</span>
          <span class="students-row-year">B3</span>
        </div>
      ))}
    </div>
  </div>

</div><!-- /members -->

<!-- ALUMNI -->
<div id="tab-alumni" class="tab-panel">
  <div class="alumni-section" style="border-bottom:1px solid var(--black);">
    <p class="alumni-section-label">PhD Alumni</p>
    <table class="alumni-table">
      <thead>
        <tr>
          <th style="width:48px;">Year</th>
          <th>Name</th>
          <th style="min-width:200px;">Current Position</th>
        </tr>
      </thead>
      <tbody>
        {phdAlumni.map((a: any) => (
          <tr>
            <td class="alumni-yr">{a.year}</td>
            <td>
              <p class="alumni-name-en">{a.name_en}</p>
              <p class="alumni-name-jp">{a.name_jp}</p>
              <p class="alumni-inst">{a.institution} · {a.degree}</p>
              {(a.researchmap || a.website) && (
                <div class="alumni-links">
                  {a.researchmap && <a href={a.researchmap} target="_blank">ResearchMap</a>}
                  {a.website && <a href={a.website} target="_blank">Website</a>}
                </div>
              )}
            </td>
            <td class="alumni-pos-cell">
              {a.position_title && a.position_title !== '—' && (
                <>
                  <p class="alumni-pos-title">{a.position_title}</p>
                  {a.position_org && <p class="alumni-pos-org">{a.position_org}</p>}
                </>
              )}
              {(!a.position_title || a.position_title === '—') && <p>—</p>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="ma-alumni-section">
    <p class="ma-alumni-section-label">Master's Alumni</p>
    <table class="ma-table">
      <thead>
        <tr>
          <th style="width:64px;">Year</th>
          <th style="width:200px;">Name</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {maAlumni.map((a: any) => (
          <tr>
            <td class="ma-yr">{a.year}</td>
            <td class="ma-name-en">{a.name_en}</td>
            <td class="ma-name-jp">{a.name_jp}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div><!-- /alumni -->

<!-- THESES -->
<div id="tab-theses" class="tab-panel">
  <div class="thesis-section">
    <p class="thesis-section-label">Student Theses</p>
    <div class="thesis-tabs">
      <button class="thesis-subtab active" onclick="switchSubTab('phd',this)">Dissertations</button>
      <button class="thesis-subtab" onclick="switchSubTab('ma',this)">Master's Theses</button>
      <button class="thesis-subtab" onclick="switchSubTab('ba',this)">Bachelor's Theses</button>
    </div>

    <!-- PhD -->
    <div id="subtab-phd" class="thesis-subpanel active">
      {groupByYear(dissertations).map(({ year, items }, gi) => (
        <>
          <div class={`thesis-year-heading${gi === 0 ? ' first' : ''}`}>{year}</div>
          {items.map((t: any) => (
            <div class="thesis-item">
              <span class="thesis-deg phd">PhD</span>
              <div>
                <p class="thesis-title">{t.title}</p>
                <p class="thesis-author">{t.author_jp}</p>
                <p class="thesis-note">{t.institution} · {t.degree}{t.note ? ` [${t.note}]` : ''}</p>
              </div>
            </div>
          ))}
        </>
      ))}
    </div>

    <!-- MA -->
    <div id="subtab-ma" class="thesis-subpanel">
      {groupByYear(mastersTheses).map(({ year, items }, gi) => (
        <>
          <div class={`thesis-year-heading${gi === 0 ? ' first' : ''}`}>{year}</div>
          {items.map((t: any) => (
            <div class="thesis-item">
              <span class="thesis-deg ma">M.A.</span>
              <div>
                <p class="thesis-title">{t.title}</p>
                <p class="thesis-author">{t.author_jp}</p>
              </div>
            </div>
          ))}
        </>
      ))}
    </div>

    <!-- BA -->
    <div id="subtab-ba" class="thesis-subpanel">
      {groupByYear(baTheses).map(({ year, items }, gi) => (
        <>
          <div class={`thesis-year-heading${gi === 0 ? ' first' : ''}`}>{year}</div>
          {items.map((t: any) => (
            <div class="thesis-item">
              <span class="thesis-deg ba">B.A.</span>
              <div>
                <p class="thesis-title">{t.title}</p>
                <p class="thesis-author">{t.author_jp}</p>
              </div>
            </div>
          ))}
        </>
      ))}
    </div>

  </div>
</div><!-- /theses -->

<!-- NEWS -->
<div id="tab-news" class="tab-panel">
  <div class="news-section">
    <p class="news-note"><em style="font-size:12px;color:var(--gray-mid);">This section is in Japanese. For English, please use your browser's translation feature (e.g. Chrome: right-click → "Translate to English").</em></p>
    <div class="news-filters">
      <button class="news-filter-btn active" onclick="filterNews('all',this)">すべて</button>
      <button class="news-filter-btn" onclick="filterNews('award',this)">受賞</button>
      <button class="news-filter-btn" onclick="filterNews('jsps',this)">学振</button>
      <button class="news-filter-btn" onclick="filterNews('grant',this)">グラント</button>
    </div>
    <ul class="news-list">
      {newsItems.map((n: any) => (
        <li class="news-item" data-tags={n.tag}>
          <span class="news-date">{n.date}</span>
          <div>
            <div class="news-tags">
              <span class={`news-tag ${n.tag}`}>
                {n.tag === 'award' ? '受賞' : n.tag === 'jsps' ? '学振' : 'グラント'}
              </span>
            </div>
            <p class="news-body"
              set:html={n.text
                .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
              }
            ></p>
            {n.url && <a href={n.url} target="_blank" class="news-body">→ 詳細</a>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</div><!-- /news -->

<script is:inline>
function switchTab(id, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.section-tab').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + id).classList.add('active');
  btn.classList.add('active');
}
function switchSubTab(id, btn) {
  document.querySelectorAll('.thesis-subpanel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.thesis-subtab').forEach(b => b.classList.remove('active'));
  document.getElementById('subtab-' + id).classList.add('active');
  btn.classList.add('active');
}
function filterNews(tag, btn) {
  document.querySelectorAll('.news-filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.news-item').forEach(item => {
    if (tag === 'all') {
      item.classList.remove('hidden');
    } else {
      const tags = (item.dataset.tags || '').split(' ');
      item.classList.toggle('hidden', !tags.includes(tag));
    }
  });
}
</script>
</BaseLayout>
