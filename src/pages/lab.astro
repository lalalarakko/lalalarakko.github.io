<script is:inline>
function switchTab(id,btn){
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.section-tab').forEach(b=>b.classList.remove('active'));
  document.getElementById('tab-'+id).classList.add('active');
  btn.classList.add('active');
}
function filterNews(tag, btn) {
  document.querySelectorAll('.news-filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.news-item').forEach(item => {
    if (tag === 'all') {
      item.classList.remove('hidden');
    } else {
      const tags = (item.dataset.tags || '').split(' ');
      item.classList.toggle('hidden', !tags.includes(tag));
    }
  });
}
function switchSubTab(id,btn){
  document.querySelectorAll('.thesis-subpanel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.thesis-subtab').forEach(b=>b.classList.remove('active'));
  document.getElementById('subtab-'+id).classList.add('active');
  btn.classList.add('active');
}
</script>
