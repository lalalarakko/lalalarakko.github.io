---
import BaseLayout from '../layouts/BaseLayout.astro';
import { load } from 'js-yaml';
import { readFileSync } from 'fs';
import { join } from 'path';
function parseFrontmatter(raw: string) {
  const match = raw.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return {};
  return load(match[1]) as Record<string, any>;
}
const cwd = process.cwd();
const positions = parseFrontmatter(readFileSync(join(cwd,'src/content/cv/positions.md'),'utf-8'));
const education = parseFrontmatter(readFileSync(join(cwd,'src/content/cv/education.md'),'utf-8'));
const grants = parseFrontmatter(readFileSync(join(cwd,'src/content/cv/grants.md'),'utf-8'));
const awards = parseFrontmatter(readFileSync(join(cwd,'src/content/cv/awards.md'),'utf-8'));
const service = parseFrontmatter(readFileSync(join(cwd,'src/content/cv/service.md'),'utf-8'));
const membership = parseFrontmatter(readFileSync(join(cwd,'src/content/cv/membership.md'),'utf-8'));
const reviewing = parseFrontmatter(readFileSync(join(cwd,'src/content/cv/reviewing.md'),'utf-8'));
const teaching = parseFrontmatter(readFileSync(join(cwd,'src/content/cv/teaching.md'),'utf-8'));
---
<BaseLayout title="CV — Masanori Takezawa" activePage="cv">
<style>
.page-top-cv{margin-top:var(--nav-h);border-bottom:1px solid var(--black);padding:48px 48px 32px;display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:24px;}
.cv-download{display:inline-flex;align-items:center;gap:10px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:var(--black);border:1px solid var(--black);padding:12px 24px;transition:all .2s;}
.cv-download:hover{background:var(--black);color:var(--white);}
.cv-ids{display:flex;flex-direction:column;gap:8px;align-items:flex-end;}
.cv-id-badge{font-size:13px;letter-spacing:.05em;color:var(--gray-dark);text-decoration:none;border:1px solid var(--gray-mid);padding:5px 12px;transition:all .2s;white-space:nowrap;}
.cv-id-badge:hover{color:var(--black);border-color:var(--gray-mid);}
.cv-body{display:grid;grid-template-columns:200px 1fr;min-height:80vh;}
.cv-nav{position:sticky;top:var(--nav-h);height:calc(100vh - var(--nav-h));overflow-y:auto;padding:40px 24px;border-right:1px solid var(--black);}
.cv-nav-title{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--gray-mid);margin-bottom:16px;}
.cv-nav ul{list-style:none;}
.cv-nav li{margin-bottom:2px;}
.cv-nav a{font-size:12px;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;color:var(--gray-dark);display:block;padding:6px 0 6px 12px;border-left:2px solid transparent;transition:all .2s;}
.cv-nav a:hover,.cv-nav a.active{color:var(--black);border-left-color:var(--accent);}
.cv-content{padding:0;}
.cv-section{padding:48px 48px 48px;border-bottom:1px solid var(--black);}
.cv-section:last-child{border-bottom:none;}
.cv-section-title{font-family:var(--serif);font-size:28px;font-weight:400;margin-bottom:36px;padding-bottom:16px;border-bottom:1px solid var(--gray-light);}
.cv-entry{display:grid;grid-template-columns:160px 1fr;gap:8px 28px;padding:20px 0;border-bottom:1px solid var(--gray-light);align-items:start;}
.cv-entry:last-child{border-bottom:none;}
.cv-entry-period{font-size:14px;color:var(--gray-dark);line-height:1.6;padding-top:3px;}
.cv-entry-title{font-size:16px;font-weight:500;color:var(--black);margin-bottom:4px;}
.cv-entry-place{font-size:15px;color:var(--gray-dark);line-height:1.6;}
.cv-entry-note{font-size:14px;color:var(--gray-dark);margin-top:4px;line-height:1.6;}
.grant-item{padding:20px 0;border-bottom:1px solid var(--gray-light);}
.grant-item:last-child{border-bottom:none;}
.grant-title{font-size:15px;font-weight:500;color:var(--black);margin-bottom:6px;}
.grant-meta{font-size:15px;color:var(--gray-dark);margin-bottom:4px;}
.grant-period{font-size:14px;color:var(--gray-dark);}
.grant-amount{font-size:14px;color:var(--gray-mid);margin-top:4px;}
.grant-section-label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:16px;margin-top:36px;}
.grant-section-label:first-child{margin-top:0;}
.service-table{width:100%;border-collapse:collapse;}
.service-table td{padding:12px 0;border-bottom:1px solid var(--gray-light);font-size:14px;vertical-align:top;}
.service-table td:first-child{color:var(--gray-mid);font-size:12px;width:160px;padding-right:16px;}
.service-table tr:last-child td{border-bottom:none;}
.member-list{list-style:none;columns:2;gap:32px;}
.member-list li{font-size:14px;color:var(--gray-dark);padding:6px 0;border-bottom:1px solid var(--gray-light);break-inside:avoid;}
.review-section-label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:12px;margin-top:32px;}
.review-section-label:first-child{margin-top:0;}
.review-list{list-style:none;columns:2;gap:32px;}
.review-list li{font-size:13px;color:var(--gray-dark);padding:5px 0;border-bottom:1px solid var(--gray-light);break-inside:avoid;}
.teaching-inst{margin-bottom:40px;}
.teaching-inst:last-child{margin-bottom:0;}
.teaching-inst-name{font-size:15px;font-weight:500;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--gray-light);}
.teaching-row{display:grid;grid-template-columns:80px 1fr auto;gap:8px 16px;padding:10px 0;border-bottom:1px solid var(--gray-light);font-size:15px;align-items:baseline;}
.teaching-row:last-child{border-bottom:none;}
.teaching-badge{font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:2px 6px;border:1px solid;white-space:nowrap;}
.teaching-badge.grad{border-color:var(--black);color:var(--black);}
.teaching-badge.undergrad{border-color:var(--gray-mid);color:var(--gray-mid);}
.teaching-badge.gen_ed{border-color:var(--gray-light);color:var(--gray-mid);}
.cv-footer-links{padding:40px 48px;border-top:1px solid var(--black);}
@media(max-width:960px){
  .page-top-cv{padding:40px 20px 24px;}
  .cv-ids{align-items:flex-start;}
  .cv-body{grid-template-columns:1fr;}
  .cv-nav{position:static;height:auto;padding:20px;border-right:none;border-bottom:1px solid var(--black);}
  .cv-nav ul{display:flex;flex-wrap:wrap;gap:2px 12px;}
  .cv-nav a{border-left:none;padding-left:0;}
  .cv-section{padding:36px 20px;}
  .cv-entry{grid-template-columns:1fr;gap:2px;}
  .service-table td:first-child{width:110px;}
  .member-list,.review-list{columns:1;}
  .teaching-row{grid-template-columns:60px 1fr auto;}
}
</style>

<div class="page-top-cv">
  <div>
    <p class="page-header-label">Curriculum Vitae</p>
    <h1 class="page-header-title">Masanori Takezawa</h1>
  </div>
  <div style="display:flex;flex-direction:column;gap:10px;align-items:flex-end;">
    <a class="cv-download" href="https://researchmap.jp/lalalarakko?lang=en" target="_blank">Full Record on ResearchMap</a>
    <div class="cv-ids">
      <a class="cv-id-badge" href="https://orcid.org/0000-0003-4103-0591" target="_blank">ORCID 0000-0003-4103-0591</a>
      <a class="cv-id-badge" href="https://scholar.google.co.jp/citations?user=xbH6eocAAAAJ" target="_blank">Google Scholar</a>
    </div>
  </div>
</div>

<div class="cv-body">
  <aside class="cv-nav">
    <p class="cv-nav-title">Sections</p>
    <ul>
      <li><a href="#positions">Academic Positions</a></li>
      <li><a href="#education">Education</a></li>
      <li><a href="#grants">Grants</a></li>
      <li><a href="#awards">Awards</a></li>
      <li><a href="#service">Service &amp; Editorial</a></li>
      <li><a href="#membership">Membership</a></li>
      <li><a href="#reviewing">Reviewing</a></li>
      <li><a href="#teaching">Teaching</a></li>
    </ul>
  </aside>

  <div class="cv-content">

    <!-- POSITIONS -->
    <section class="cv-section" id="positions">
      <h2 class="cv-section-title">Academic Positions</h2>
      {(positions.positions || []).map((p: any) => (
        <div class="cv-entry">
          <div class="cv-entry-period">{p.period}</div>
          <div>
            <p class="cv-entry-title">{p.title}</p>
            <p class="cv-entry-place">{p.place}</p>
            {p.note && <p class="cv-entry-note">{p.note}</p>}
          </div>
        </div>
      ))}
    </section>

    <!-- EDUCATION -->
    <section class="cv-section" id="education">
      <h2 class="cv-section-title">Education</h2>
      {(education.education || []).map((e: any) => (
        <div class="cv-entry">
          <div class="cv-entry-period">{e.period}</div>
          <div>
            <p class="cv-entry-title">{e.degree}</p>
            <p class="cv-entry-place">{e.place}</p>
          </div>
        </div>
      ))}
    </section>

    <!-- GRANTS -->
    <section class="cv-section" id="grants">
      <h2 class="cv-section-title">Grants &amp; Funding</h2>
      <p class="grant-section-label">Principal Investigator</p>
      {(grants.pi_grants || []).map((g: any) => (
        <div class="grant-item">
          <p class="grant-title">{g.title}</p>
          <p class="grant-meta">{g.meta}</p>
          <p class="grant-period">{g.period}</p>
          {g.amount && <p class="grant-amount">{g.amount}</p>}
        </div>
      ))}
      <p class="grant-section-label">Co-Investigator</p>
      {(grants.coi_grants || []).map((g: any) => (
        <div class="grant-item">
          <p class="grant-title">{g.title}</p>
          <p class="grant-meta">{g.meta}</p>
          <p class="grant-period">{g.period}</p>
          {g.amount && <p class="grant-amount">{g.amount}</p>}
        </div>
      ))}
    </section>

    <!-- AWARDS -->
    <section class="cv-section" id="awards">
      <h2 class="cv-section-title">Awards &amp; Honours</h2>
      {(awards.awards || []).map((a: any) => (
        <div class="cv-entry">
          <div class="cv-entry-period">{a.year}</div>
          <div>
            <p class="cv-entry-title">{a.title}</p>
            <p class="cv-entry-place">{a.org}</p>
            {a.note && <p class="cv-entry-note">{a.note}</p>}
          </div>
        </div>
      ))}
    </section>

    <!-- SERVICE -->
    <section class="cv-section" id="service">
      <h2 class="cv-section-title">Service &amp; Editorial Roles</h2>
      <table class="service-table">
        <tbody>
          {(service.editorial || []).map((s: any) => (
            <tr>
              <td>{s.period}</td>
              <td>{s.role}, <span set:html={s.org.replace(/\*(.*?)\*/g, '<em>$1</em>')}></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- MEMBERSHIP -->
    <section class="cv-section" id="membership">
      <h2 class="cv-section-title">Professional Membership</h2>
      <ul class="member-list">
        {(membership.memberships || []).map((m: string) => <li>{m}</li>)}
      </ul>
    </section>

    <!-- REVIEWING -->
    <section class="cv-section" id="reviewing">
      <h2 class="cv-section-title">Ad Hoc Reviewing</h2>
      <p class="review-section-label">Funding Agencies</p>
      <ul class="review-list">
        {(reviewing.agencies || []).map((a: string) => <li>{a}</li>)}
      </ul>
      <p class="review-section-label">Journals</p>
      <ul class="review-list">
        {(reviewing.journals || []).map((j: string) => <li>{j}</li>)}
      </ul>
    </section>

    <!-- TEACHING -->
    <section class="cv-section" id="teaching">
      <h2 class="cv-section-title">Teaching</h2>
      {(teaching.institutions || []).map((inst: any) => (
        <div class="teaching-inst">
          <p class="teaching-inst-name">{inst.name}</p>
          {(inst.courses || []).map((c: any) => (
            <div class="teaching-row">
              <span class={`teaching-badge ${c.level}`}>
                {c.level === 'grad' ? 'Grad.' : c.level === 'undergrad' ? 'UG' : 'Gen.Ed.'}
              </span>
              <span>{c.title}</span>
              <span style="font-size:12px;color:var(--gray-mid);">{c.period}</span>
            </div>
          ))}
        </div>
      ))}
      {teaching.invited && teaching.invited.length > 0 && (
        <>
          <p class="teaching-inst-name" style="margin-top:40px;">Invited Lectures</p>
          {(teaching.invited || []).map((c: any) => (
            <div class="teaching-row">
              <span class={`teaching-badge ${c.level}`}>
                {c.level === 'grad' ? 'Grad.' : 'UG'}
              </span>
              <span>{c.title} — {c.place}</span>
              <span style="font-size:12px;color:var(--gray-mid);">{c.period}</span>
            </div>
          ))}
        </>
      )}
    </section>

    <div class="cv-footer-links">
      <a href="https://researchmap.jp/lalalarakko" target="_blank" style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;color:var(--black);border:1px solid var(--black);padding:10px 20px;white-space:nowrap;transition:all .2s;" onmouseover="this.style.background='#0a0a0a';this.style.color='#f5f4f0';" onmouseout="this.style.background='none';this.style.color='#0a0a0a';">ResearchMap (Japanese) →</a>
    </div>

  </div><!-- /cv-content -->
</div><!-- /cv-body -->

<script>
// Highlight active nav section on scroll
const sections = document.querySelectorAll('.cv-section');
const navLinks = document.querySelectorAll('.cv-nav a');
const observer = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      navLinks.forEach(l => l.classList.remove('active'));
      const active = document.querySelector(`.cv-nav a[href="#${entry.target.id}"]`);
      active?.classList.add('active');
    }
  });
}, { rootMargin: '-20% 0px -70% 0px' });
sections.forEach(s => observer.observe(s));
</script>
</BaseLayout>
